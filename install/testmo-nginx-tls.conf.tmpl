# testMO metrics API over TLS — /etc/nginx/sites-available/testmo
#
# Rendered by setup.sh when --domain is passed; {{DOMAIN}} is substituted in.
# Editing the copy on the server accomplishes nothing, the next run overwrites
# it — change this template instead.
#
# This is not a hardening step. The dashboard is served over https and calls
# each agent directly from the customer's browser, and a browser refuses to
# load http:// from an https:// page. Without a real certificate here every
# request is blocked as mixed content before it leaves the page, and the
# dashboard sees a network error carrying no status code at all.
#
# Still :9443, never :443. The customer's own nginx owns :443 for their RPC;
# adding a location to that block is the one change that could take their node
# offline. The two never share a listener.
#
# The certificate is Let's Encrypt, renewed by certbot.timer against the :80
# challenge vhost in testmo-acme.conf.tmpl, which is why that vhost and port 80
# both have to stay in place after the install.
#
# Everything below the ssl_* block is identical to testmo-nginx.conf on
# purpose: diff the two and the only difference should be the TLS listener.
# Ports are hardcoded in both, matching setup.sh's API_PORT/AGENT_PORT.
#
# No http2: Ubuntu 22.04 ships nginx 1.18, where `http2 on;` is an unknown
# directive and `nginx -t` fails outright. HTTP/1.1 is ample for JSON polls.

server {
    listen 9443 ssl;
    listen [::]:9443 ssl;

    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;

    # Set explicitly: the distro default still enables TLSv1 and TLSv1.1 on
    # 22.04, which modern browsers refuse anyway.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:testmo_tls:1m;
    ssl_session_timeout 1h;

    # Nothing here should ever be cached by an intermediary.
    add_header Cache-Control "no-store" always;

    location /api/v1/ {
        limit_req zone=testmo burst=20 nodelay;

        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # /internal/metrics is deliberately absent: it is unauthenticated and must
    # stay reachable only from localhost, where Prometheus scrapes it.
    location / {
        return 404 '{"error":"not found"}';
        default_type application/json;
    }
}
